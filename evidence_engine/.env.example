# 이름만 둔다. 실제 값은 .env에 넣고, .env는 커밋하지 않는다.

# 제주데이터허브 Open API 프로젝트 키 (open.jejudatahub.net/api/proxy/<dataKey>/<projectKey>)
JEJUDATAHUB_PROJECT_KEY=

# LLM API 키. 기본은 Anthropic(Claude) 하나면 된다 (config.yaml dev_llm.provider / llm.provider)
ANTHROPIC_API_KEY=
# OpenRouter 를 쓸 때만 (여러 모델 비교 등)
OPENROUTER_API_KEY=

# 유료 호출 허용 스위치. 사람이 직접 1로 설정했을 때만 실제 LLM 호출이 나간다.
# ALLOW_PAID_CALLS=1
